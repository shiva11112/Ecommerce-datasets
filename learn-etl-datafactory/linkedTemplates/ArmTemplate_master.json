{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "learn-etl-datafactory"
		},
		"ds_target_targetfolder_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ds_target_targetfolder'"
		},
		"ls_azure_sql_connection_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azure_sql_connection'"
		},
		"ls_bronze_container_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_bronze_container'"
		},
		"ls_dev_source_rawfiles_olist_customers_dataset_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_dev_source_rawfiles_olist_customers_dataset'"
		},
		"ls_dev_target_targetfolder_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_dev_target_targetfolder'"
		},
		"ls_source_rawfiles_folder_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_source_rawfiles_folder'"
		},
		"ls_source_wildpath_csv_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_source_wildpath_csv'"
		},
		"ds_target_targetfolder_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://infostorageaccount.dfs.core.windows.net/"
		},
		"ls_azure_sql_connection_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "asqladventureworks.database.windows.net"
		},
		"ls_azure_sql_connection_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "asqldatabaseadventureworks"
		},
		"ls_azure_sql_connection_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "shivaadmin"
		},
		"ls_bronze_container_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://infostorageaccount.dfs.core.windows.net/"
		},
		"ls_dev_source_rawfiles_olist_customers_dataset_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://infostorageaccount.dfs.core.windows.net/"
		},
		"ls_dev_target_targetfolder_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://infostorageaccount.dfs.core.windows.net/"
		},
		"ls_source_rawfiles_folder_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://infostorageaccount.dfs.core.windows.net/"
		},
		"ls_source_wildpath_csv_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://infostorageaccount.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "learn-etl-datafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ds_target_targetfolder_accountKey": {
						"value": "[parameters('ds_target_targetfolder_accountKey')]"
					},
					"ls_azure_sql_connection_password": {
						"value": "[parameters('ls_azure_sql_connection_password')]"
					},
					"ls_bronze_container_accountKey": {
						"value": "[parameters('ls_bronze_container_accountKey')]"
					},
					"ls_dev_source_rawfiles_olist_customers_dataset_accountKey": {
						"value": "[parameters('ls_dev_source_rawfiles_olist_customers_dataset_accountKey')]"
					},
					"ls_dev_target_targetfolder_accountKey": {
						"value": "[parameters('ls_dev_target_targetfolder_accountKey')]"
					},
					"ls_source_rawfiles_folder_accountKey": {
						"value": "[parameters('ls_source_rawfiles_folder_accountKey')]"
					},
					"ls_source_wildpath_csv_accountKey": {
						"value": "[parameters('ls_source_wildpath_csv_accountKey')]"
					},
					"ds_target_targetfolder_properties_typeProperties_url": {
						"value": "[parameters('ds_target_targetfolder_properties_typeProperties_url')]"
					},
					"ls_azure_sql_connection_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_sql_connection_properties_typeProperties_server')]"
					},
					"ls_azure_sql_connection_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_sql_connection_properties_typeProperties_database')]"
					},
					"ls_azure_sql_connection_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_sql_connection_properties_typeProperties_userName')]"
					},
					"ls_bronze_container_properties_typeProperties_url": {
						"value": "[parameters('ls_bronze_container_properties_typeProperties_url')]"
					},
					"ls_dev_source_rawfiles_olist_customers_dataset_properties_typeProperties_url": {
						"value": "[parameters('ls_dev_source_rawfiles_olist_customers_dataset_properties_typeProperties_url')]"
					},
					"ls_dev_target_targetfolder_properties_typeProperties_url": {
						"value": "[parameters('ls_dev_target_targetfolder_properties_typeProperties_url')]"
					},
					"ls_source_rawfiles_folder_properties_typeProperties_url": {
						"value": "[parameters('ls_source_rawfiles_folder_properties_typeProperties_url')]"
					},
					"ls_source_wildpath_csv_properties_typeProperties_url": {
						"value": "[parameters('ls_source_wildpath_csv_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}