{
	"name": "pl_sql_to_sql_dynamic",
	"properties": {
		"activities": [
			{
				"name": "Copy data Azure to SQL to Azure SQL",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "serverName"
					}
				],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select * from dbo.product",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"tableOption": "autoCreate",
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_azure_sql_dynamic",
						"type": "DatasetReference",
						"parameters": {
							"serverName": {
								"value": "@pipeline().parameters.pl_serverName",
								"type": "Expression"
							},
							"databaseName": {
								"value": "@pipeline().parameters.pl_databaseName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_to_sql_sink",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"pl_serverName": {
				"type": "string",
				"defaultValue": "asqladventureworks.database.windows.net"
			},
			"pl_databaseName": {
				"type": "string",
				"defaultValue": "asqldatabaseadventureworks"
			},
			"pl_sinkDatabaseName": {
				"type": "string",
				"defaultValue": "asqldatabase-sink"
			}
		},
		"folder": {
			"name": "azure-ETL-project"
		},
		"annotations": []
	},
	"policy": {
		"logging": {
			"enableCopyActivityLog": true,
			"copyActivityLogSettings": {
				"logLevel": "Verbose",
				"enableReliableLogging": false
			}
		}
	}
}